rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared POS data documents (docPath in firebase-config.js must stay under pos/)
    match /pos/{docId} {
      // reads: open (the doc path itself is the "password" — keep it unguessable);
      // write-field validation only makes sense for writes, never reads — that's
      // why read and write are split here.
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['data','rev','updatedAt','device','deviceName']);
      allow delete: if false;
    }

    // Atomic daily bill-number counter used by the POS
    match /induswok_counters/{docId} {
      allow read, write: if true;
    }

    // Sharded settled bills/recent bills used by the POS
    match /induswok_bills/{billId} {
      allow read, write: if true;
    }

    // Live device presence / multi-device status
    match /pos_devices/{deviceId} {
      allow read, write: if true;
    }

    // Customer QR orders — the customer page creates/cancels, the POS reads,
    // accepts and cleans up old ones
    match /induswok_qr_orders/{orderId} {
      allow read, write: if true;
    }

    // Remote print queue → the restaurant phone prints these on its Bluetooth printer
    match /induswok_print_jobs/{jobId} {
      allow read, write: if true;
    }

    // "Call waiter / request bill" pings from the table QR page
    match /induswok_table_requests/{reqId} {
      allow read, write: if true;
    }

    // Everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
